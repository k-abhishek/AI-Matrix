{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "outDir": "./server/dist",
    "rootDir": "./server/src"
  },
  "include": ["server/src/**/*"],
  "exclude": ["node_modules", "client", "server/dist"]
}
